                  "raw": "{\n  \"test_results\": \"{\\\"categories\\\": {\\\"cannabinoids\\\": {\\\"info_fields\\\": {\\\"input_units\\\": \\\"mg/g\\\", \\\"report_units\\\": \\\"mg/g\\\", \\\"date_tested\\\": \\\"2025-01-15\\\"}, \\\"compounds\\\": [{\\\"name\\\": \\\"thc\\\", \\\"value\\\": \\\"18.5\\\"}, {\\\"name\\\": \\\"cbd\\\", \\\"value\\\": \\\"0.8\\\"}]}}}\",\n  \"publish_data\": false\n}",
